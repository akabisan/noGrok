{
  "manifest_version": 2,
  "name": "noGrok",
  "version": "1.0",
  "description": "Remove Grok on Twitter.",
  "icons": {
    "48": "icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "noGrok Settings",
    "default_icon": "icon.png" 
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nogrok-firefox@akabi"
    }
  }
}